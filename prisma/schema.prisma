// Clock-Now — multi-tenant timekeeping platform
// Prisma schema (PostgreSQL)
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================
// Businesses (tenants)
//
// Each business is a separate client. An ADMIN owns one business.
// All agents, attendance events, compensation records, and correction
// requests are scoped to a business — admins can never see another
// business's data.
// =====================================================

model Business {
  id          String   @id @default(cuid())
  name        String   // Display name (e.g., "Life Dream BIG")
  slug        String   @unique // URL-friendly identifier (e.g., "life-dream-big")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // The admin user who owns/manages this business.
  ownerAdminId String? @unique // → User.id (the ADMIN for this business)
  ownerAdmin   User?   @relation("BusinessOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)

  // All users belonging to this business (admins + agents).
  users             User[]
  attendanceEvents  AttendanceEvent[]
  compensationRecords CompensationRecord[]
  correctionRequests CorrectionRequest[]

  @@index([active])
  @@index([ownerAdminId])
}

// =====================================================
// Roles
// =====================================================

model Role {
  id        String   @id @default(cuid())
  name      String   @unique // "SUPER_ADMIN" | "ADMIN" | "SURVEY_AGENT"
  users     User[]
  createdAt DateTime @default(now())
}

// =====================================================
// Users (super admins + business admins + agents)
// =====================================================

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  employeeId         String? // company-assigned agent/employee ID (nullable for super admins)
  username           String   @unique // login identifier
  // Password hashing: bcrypt (cost 12). Never store plaintext.
  passwordHash       String
  // Forces password change on next login. Used for new accounts and admin-initiated resets.
  mustChangePassword Boolean  @default(false)
  active             Boolean  @default(true)
  // Protected accounts cannot be edited, deactivated, rate-changed, or
  // password-reset by anyone except a SUPER_ADMIN. Used for the platform
  // owner's super admin account.
  isProtected        Boolean  @default(false)
  roleId             String
  role               Role     @relation(fields: [roleId], references: [id])
  // Multi-tenancy: which business does this user belong to?
  // Super admins have businessId = null (they belong to the platform).
  // Admins and agents have businessId pointing to their employer.
  businessId         String?
  business           Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  // For ADMIN users: the business they own/manage (if they're the owner).
  ownedBusiness      Business? @relation("BusinessOwner")
  // Attendance events emitted by this user (agent).
  attendanceEvents   AttendanceEvent[]
  // Compensation history (effective-dated hourly rates).
  compensationRecords CompensationRecord[]
  // Correction requests submitted by this user.
  correctionRequestsSubmitted CorrectionRequest[]
  // Correction requests reviewed/decided by this user (admin).
  correctionRequestsReviewed CorrectionRequest[] @relation("ReviewedBy")
  // Audit log entries produced by or targeting this user.
  auditLogsAsActor  AuditLog[] @relation("AuditActor")
  auditLogsAsTarget AuditLog[] @relation("AuditTarget")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([roleId])
  @@index([active])
  @@index([isProtected])
  @@index([businessId])
}

// =====================================================
// Compensation history (effective-dated hourly rates)
// =====================================================

model CompensationRecord {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId   String?
  business     Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  hourlyRate   Float    // stored as decimal dollars (e.g., 5.00)
  effectiveDate DateTime // date the rate takes effect (business tz date)
  note         String?
  createdBy    String   // admin userId (or "seed")
  createdAt    DateTime @default(now())

  @@index([userId, effectiveDate])
  @@index([businessId])
}

// =====================================================
// Attendance event ledger (source of truth)
// =====================================================

model AttendanceEvent {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId      String?
  business        Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  // CLOCK_IN | CLOCK_OUT | BREAK_START | BREAK_END
  eventType       String
  // Stored in UTC. Business timezone applied at read time.
  timestampUtc    DateTime
  // The business date (America/New_York) at the moment of the event.
  businessDate    String // YYYY-MM-DD
  source          String   @default("web")
  note            String?
  correctedById   String?
  correctionReason String?
  createdAt       DateTime @default(now())

  @@index([userId, businessDate])
  @@index([userId, timestampUtc])
  @@index([eventType, businessDate])
  @@index([businessId])
}

// =====================================================
// Correction requests
// =====================================================

model CorrectionRequest {
  id              String   @id @default(cuid())
  userId          String   // agent submitting the request
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId      String?
  business        Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  targetDate      String
  requestedChange String
  requestedTime   String?
  reason          String
  note            String?
  status          String   @default("PENDING")
  reviewedById    String?
  reviewer        User?    @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewNote      String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, status])
  @@index([status])
  @@index([businessId])
}

// =====================================================
// Audit log (append-only)
// =====================================================

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id])
  targetId     String?
  target       User?    @relation("AuditTarget", fields: [targetId], references: [id])
  action       String
  metadata     String
  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([targetId])
  @@index([action])
  @@index([createdAt])
}

// =====================================================
// Settings (company-wide; e.g., default hourly rate)
// =====================================================

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
