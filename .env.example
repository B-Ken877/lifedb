# =====================================================
# LIFE DREAM BIG — Clocking System — Environment variables
# =====================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit real credentials to Git.

# ---------- Database ----------
# Local dev: SQLite file path.
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Production (Vercel): use a Postgres connection string.
# Examples: Neon, Supabase, Railway, Vercel Postgres.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/lifedb?schema=public
#
# When switching to Postgres, change the `provider` in prisma/schema.prisma
# from "sqlite" to "postgresql", then run `bun run db:push`.

# ---------- Authentication ----------
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# Public app URL (used by NextAuth for callbacks).
# On Vercel, this is automatically set as NEXTAUTH_URL by the NextAuth integration
# or you can set it explicitly.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Business config ----------
# All employees operate on Eastern Time (America/New_York).
BUSINESS_TIMEZONE=America/New_York

# Default hourly rate (USD) used when an employee has no compensation record.
DEFAULT_HOURLY_RATE=5.00

# ---------- Seed (initial admin) ----------
# Used by `bun run db:seed` to create the initial admin account.
# Change these before running seed in production.
SEED_ADMIN_EMAIL=admin@lifedreambig.local
SEED_ADMIN_PASSWORD=ChangeMe!2025
SEED_ADMIN_NAME=System Administrator

# ---------- Seed (protected owner agent) ----------
# Optional. If set, `bun run db:seed` also creates a protected owner agent
# account. Protected accounts CANNOT be edited, deactivated, rate-changed,
# or password-reset by an admin. The owner can still sign in normally and
# change their own password via /agent/profile.
# Leave blank to skip creating the protected owner account.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=Owner
SEED_OWNER_USERNAME=owner
SEED_OWNER_EMPLOYEE_ID=OWNER-001
SEED_OWNER_HOURLY_RATE=5.00

# ---------- Realtime service ----------
# The realtime mini-service is a separate long-lived process (NOT a Vercel
# serverless function). It receives POST /notify from API routes and
# broadcasts via socket.io to admin dashboard clients.
#
# In local dev, the Next.js app talks to http://localhost:3003/notify.
# On Vercel, deploy the realtime service separately (Railway, Render, Fly.io)
# and set REALTIME_SERVICE_URL to its public HTTPS URL.
REALTIME_SERVICE_URL=http://localhost:3003

# Optional: expose the realtime URL to the client (used by the admin
# dashboard's socket.io connector). If you deployed the realtime service
# separately, set this to its public wss:// URL.
# NEXT_PUBLIC_REALTIME_URL=https://realtime.your-domain.com
